rules_version = '2';

// قواعد أمان قاعدة بيانات Firestore لموقع "فل تنك صبراتة"
//
// كيف تستخدم هذا الملف:
// من داخل Firebase Console افتح مشروعك ← Firestore Database ← تبويب Rules،
// ثم انسخ كل محتوى هذا الملف والصقه هناك مكان القواعد الموجودة، واضغط Publish.
//
// نموذج الحماية (بعد التفعيل):
// دخول لوحة مديرية الأمن أصبح يتطلب تسجيل دخول حقيقي عبر Firebase Authentication
// (بريد إلكتروني وكلمة مرور)، وليس مجرد رمز PIN داخل الواجهة. الحسابات تُنشأ
// فقط لأعضاء اللجنة الموثوقين من قِبل مدير المشروع — لا يوجد تسجيل ذاتي مفتوح.
// كل عمليات الكتابة الحساسة (إدارة المحطات، استدعاء/إلغاء الأدوار، تسجيل
// الشحنات وقراءات العدادات) تتطلب أن يكون المستخدم مسجّلاً دخوله فعلياً على
// مستوى قاعدة البيانات، وليس فقط على مستوى الواجهة — أي شخص متمرس يحاول
// مخاطبة قاعدة البيانات مباشرة بدون تسجيل دخول صالح سيُرفض طلبه تلقائياً.
// التسجيل في طابور الانتظار يبقى مفتوحاً للجميع بدون تسجيل دخول (هذا مقصود،
// حتى لا يحتاج السائق العادي حساباً لتسجيل دوره).

function isCommittee() {
  return request.auth != null;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // بيانات المحطات (الاسم، الحالة، رمز صاحب المحطة)
    match /stations/{stationId} {
      allow read: if true;
      allow write: if isCommittee();

      // قائمة الانتظار الخاصة بكل محطة (الاسم، رقم اللوحة، الحالة)
      match /queue/{entryId} {
        allow read: if true;
        allow create: if true;                    // أي سائق يقدر يسجّل نفسه بدون حساب
        allow update, delete: if isCommittee();    // استدعاء/إتمام/إلغاء الدور — للجنة فقط
      }

      // سجل الشحنات الواصلة للمحطة (عدد الترلات، صور الترلة والفاتورة) — لمنع التهريب
      match /shipments/{shipmentId} {
        allow read, write: if isCommittee();
      }

      // قراءات عدادات الطرمبات (المضخات) لحساب الكميات المباعة
      match /pumpReadings/{readingId} {
        allow read, write: if isCommittee();
      }
    }

    // أي مسار آخر غير معرّف أعلاه: ممنوع تماماً
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
