rules_version = '2';

// قواعد أمان قاعدة بيانات Firestore لموقع "قوائم تعبئة صبراتة"
//
// كيف تستخدم هذا الملف:
// من داخل Firebase Console افتح مشروعك ← Firestore Database ← تبويب Rules،
// ثم انسخ كل محتوى هذا الملف والصقه هناك مكان القواعد الموجودة، واضغط Publish.
//
// ملاحظة مهمة وصريحة عن حدود هذا النموذج الأمني:
// هذا الموقع لا يستخدم تسجيل دخول (Firebase Authentication) — الحماية الوحيدة
// لصفحة "مديرية الأمن" هي رمز (PIN) داخل واجهة الموقع نفسه (ملف index.html).
// هذا يكفي لمنع الشخص العادي من العبث بالقوائم عن طريق الصدفة أو من واجهة
// الموقع، لكنه **لا يمنع تقنياً** شخصاً متمرساً يعرف كيف يخاطب قاعدة البيانات
// مباشرة من التعديل أو الحذف، لأن القواعد أدناه تسمح بالقراءة والكتابة للجميع.
// لهذا السبب:
//   • لا تضع أي بيانات حسّاسة (كأرقام هوية أو معلومات مالية) في هذا النظام.
//   • غيّر رمز الدخول (SECURITY_PIN) في index.html إلى رمز خاص بكم فقط.
//   • لا تشارك رابط "#security" إلا مع أعضاء اللجنة الموثوقين.
// إن رغبتم لاحقاً في حماية أقوى (تمنع التلاعب حتى من قاعدة البيانات مباشرة)،
// فالخطوة التالية هي تفعيل Firebase Authentication وربط القواعد بحسابات
// مسجّلة لأعضاء اللجنة فقط — هذا تطوير مستقبلي ممكن عند الحاجة.

service cloud.firestore {
  match /databases/{database}/documents {

    // بيانات المحطات (الاسم، الحالة، رمز صاحب المحطة)
    match /stations/{stationId} {
      allow read: if true;
      allow write: if true;

      // قائمة الانتظار الخاصة بكل محطة (الاسم، رقم اللوحة، الحالة)
      match /queue/{entryId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // أي مسار آخر غير معرّف أعلاه: ممنوع تماماً
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
